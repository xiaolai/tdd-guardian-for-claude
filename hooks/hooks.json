{
  "description": "PreToolUse guards Bash commit/push commands until every gating lane has a fresh pass; TaskCompleted runs the taskCompleted lanes, merges coverage, and records per-lane gate state.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tdd-guardian/pretool_guard.js\""
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tdd-guardian/taskcompleted_gate.js\""
          }
        ]
      }
    ]
  }
}
